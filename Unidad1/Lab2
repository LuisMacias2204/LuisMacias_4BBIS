class Post:
    def __init__(self, contenido, fecha, likes):
        self.contenido = contenido
        self.fecha = fecha
        self.likes = likes

    def mostrar_post(self):
        print(f"Post: {self.contenido}, Fecha: {self.fecha}, Likes: {self.likes}")


class Comentario:
    def __init__(self, autor, texto, receiver):
        self.autor = autor
        self.texto = texto
        self.receiver = receiver

    def mostrar_comentario(self):
        print(f"Autor: {self.autor}, Comentario: {self.texto}, Fecha: {self.fecha}")


class Mensaje:
    def __init__(self, remitente, destinatario, contenido):
        self.remitente = remitente
        self.destinatario = destinatario
        self.contenido = contenido

    def enviar_mensaje(self):
        print(f"{self.remitente} le envio un mensaje a {self.destinatario}: {self.contenido}")


